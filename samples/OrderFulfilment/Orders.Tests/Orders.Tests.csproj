<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OrderFulfilment sample, Orders tests (WP-S.13). Workflows/ holds the specs SourceFlow Studio generated for the
    order-fulfilment workflow, one test per path of the minimal cover (sourceflow.domain.yaml: tests, module); the other
    files are written by hand.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <OutputType>Exe</OutputType>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <!-- CA1707: underscores in test names; CA2007: no ConfigureAwait in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Tooling\SourceFlow.Testing\SourceFlow.Testing.csproj" />
    <ProjectReference Include="..\Orders\Orders.csproj" />
    <ProjectReference Include="..\Inventory\Inventory.csproj" />
    <ProjectReference Include="..\Payments\Payments.csproj" />
    <ProjectReference Include="..\Shipping\Shipping.csproj" />
  </ItemGroup>
</Project>
