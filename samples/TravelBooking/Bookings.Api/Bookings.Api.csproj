<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    TravelBooking sample host: the Bookings service on PostgreSQL (schema "bookings"), with the AWS, Azure or
    Google Cloud transport to the other service. docker-compose.yml runs it against LocalStack.
  -->
  <PropertyGroup>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>sourceflow-travel-bookings</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ServiceHost.cs" Link="ServiceHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Hosting\SourceFlow.AspNetCore\SourceFlow.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\Storage\SourceFlow.Storage.PostgreSQL\SourceFlow.Storage.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\..\src\Cloud\SourceFlow.Cloud.Aws\SourceFlow.Cloud.Aws.csproj" />
    <ProjectReference Include="..\..\..\src\Cloud\SourceFlow.Cloud.Azure\SourceFlow.Cloud.Azure.csproj" />
    <ProjectReference Include="..\..\..\src\Cloud\SourceFlow.Cloud.Gcp\SourceFlow.Cloud.Gcp.csproj" />
    <ProjectReference Include="..\..\..\src\Tooling\SourceFlow.Tool\SourceFlow.Tool.csproj" />
    <ProjectReference Include="..\Bookings\Bookings.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
