<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Interim demo console for the docker-compose demo: browse a service's query catalog, run SFQL/SQL queries and send
    the Bank sample's commands. It is not SourceFlow Studio (the workflow designer of doc 15, track S); it talks to a
    service only through its HTTP endpoints, via a same-origin proxy.
  -->
  <PropertyGroup>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
