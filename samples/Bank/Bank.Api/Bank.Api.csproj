<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Bank sample host: the Accounts, Transfers and Notifications modules in one service on PostgreSQL (demo image). -->
  <PropertyGroup>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>sourceflow-bank-api</UserSecretsId>
    <!-- The AOT check (ARCH-06): dotnet publish -p:SourceFlowAotCheck=true. PublishAot is set here, not on the command
         line, because a global property also reaches the netstandard2.0 source generator, which cannot be AOT-compiled
         (NETSDK1207). -->
    <PublishAot Condition="'$(SourceFlowAotCheck)' == 'true'">true</PublishAot>
    <!-- SourceFlow.Tool is referenced as a library (the in-service CLI, ADR-031), not run as a separate executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Hosting\SourceFlow.AspNetCore\SourceFlow.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\Storage\SourceFlow.Storage.PostgreSQL\SourceFlow.Storage.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\..\src\Tooling\SourceFlow.Tool\SourceFlow.Tool.csproj" />
    <ProjectReference Include="..\Bank.Contracts\Bank.Contracts.csproj" />
    <ProjectReference Include="..\Bank.Accounts\Bank.Accounts.csproj" />
    <ProjectReference Include="..\Bank.Transfers\Bank.Transfers.csproj" />
    <ProjectReference Include="..\Bank.Notifications\Bank.Notifications.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
