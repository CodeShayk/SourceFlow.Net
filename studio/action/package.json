  },
  "dependencies": {
    "@sourceflow/core-client": "*",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
