<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Roslyn incremental generator + analyzers (ADR-004). Build component of SourceFlow.Net, packed into its
    analyzers folder. netstandard2.0 is the compiler-plugin contract (RS1041), not a consumer target: this is
    the only non-net10.0 project in v3 and it never runs in the application.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      RS1038: the SF0010 code fix needs Workspaces. The compiler never instantiates code-fix providers, so the
      Workspaces reference is only resolved inside the IDE. Kept in this assembly to stay the single non-net10.0
      project (ADR-027).
    -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>
  <!--
    One DSL implementation (ADR-027 §6): the portable SourceFlow.Studio/Dsl sources are compiled into the generator to
    read and validate *.sfflow.yaml (SF0020). The engine sources (model, guards, simulator, state JSON) are embedded and
    injected, as internal types, into services that own workflows; services without workflows get none of it.
    YamlDotNet is bundled next to the generator in the analyzers folder (IR-14).
  -->
  <PropertyGroup>
    <DslRoot>..\..\Workflows\SourceFlow.Studio\Dsl\</DslRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(DslRoot)Json\*.cs;$(DslRoot)Manifests\*.cs;$(DslRoot)Model\*.cs;$(DslRoot)Expressions\*.cs;$(DslRoot)Diagnostics\*.cs;$(DslRoot)Reading\*.cs;$(DslRoot)Validation\*.cs;$(DslRoot)WorkflowAnalysis.cs" Link="Dsl\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(DslRoot)Json\JsonLite.cs;$(DslRoot)Model\WorkflowModel.cs;$(DslRoot)Model\IsoDuration.cs;$(DslRoot)Model\CorrelationPath.cs;$(DslRoot)Model\WorkflowJson.cs;$(DslRoot)Expressions\Guard.cs;$(DslRoot)Simulation\WorkflowSimulator.cs;$(DslRoot)Simulation\WorkflowIds.cs;$(DslRoot)Simulation\SimulationStateJson.cs" LogicalName="Engine/%(Filename)%(Extension)" Link="Engine\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Workflows\WorkflowBridge.txt" LogicalName="Engine/WorkflowBridge.cs" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
