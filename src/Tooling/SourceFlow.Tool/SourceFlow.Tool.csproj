<Project Sdk="Microsoft.NET.Sdk">
  <!--
    dotnet sourceflow (WP-4.1, ADR-031): store-level commands run from the global tool with a connection string; commands
    that need the service's model run inside the service (dotnet run, then: sourceflow ...) through SourceFlowCli.RunAsync.
    migrate v2 comes with WP-5.4 and the Studio commands with track S.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sourceflow</ToolCommandName>
    <Description>The dotnet sourceflow command-line tool.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\SourceFlow.Net\SourceFlow.Net.csproj" />
    <ProjectReference Include="..\..\Storage\SourceFlow.Storage.PostgreSQL\SourceFlow.Storage.PostgreSQL.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
