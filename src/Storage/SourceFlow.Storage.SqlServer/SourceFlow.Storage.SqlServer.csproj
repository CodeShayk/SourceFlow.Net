<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SourceFlow.Net v3: SQL Server implementation of the persistence SPI (event store, outbox, inbox, checkpoints, leases, documents) and the SFQL SQL Server compiler.</Description>
    <PackageTags>sourceflow;event-sourcing;cqrs;sqlserver;azure-sql</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\SourceFlow.Net\SourceFlow.Net.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <InternalsVisibleTo Include="SourceFlow.Storage.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" LogicalName="SourceFlow.Storage.SqlServer.Schema.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
