<Project>
  <PropertyGroup>
    <!-- Also bundled next to the generator in the analyzers folder (WP-S.5, IR-14): one version for both. -->
    <YamlDotNetVersion>16.3.0</YamlDotNetVersion>
  </PropertyGroup>
  <!-- Central Package Management (plan 02 §6). All versions live here. Runtime packages track the .NET 10 LTS line. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime (core)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <!-- Test-only (UT-OTEL, WP-4.6): the SDK and its in-memory exporter; the core never references the SDK (ARCH-01). -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Fuzzing (WP-5.5): libFuzzer mode for fuzz/SourceFlow.Fuzz. -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <!-- Pinned above the vulnerable 9.0.x that Microsoft.Data.SqlClient brings transitively (GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Cloud transports">
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.13" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.13" />
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.101.5" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.101.3" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.39.0" />
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Generator (Roslyn 4.14 loads in every .NET 10 SDK compiler)">
    <PackageVersion Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Testing toolkit and tests">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="JsonSchema.Net" Version="7.3.4" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Microsoft.Testing.Platform extensions behind the CI's coverage and TRX report options (TrxReport follows the platform's version). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
