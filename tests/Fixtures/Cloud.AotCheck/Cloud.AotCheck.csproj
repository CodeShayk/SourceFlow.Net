<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The cloud AOT check (ARCH-06), in CI:
      dotnet publish tests/Fixtures/Cloud.AotCheck -c Release -p:SourceFlowAotCheck=true -warnaserror
    The AWS and Azure adapters are marked IsAotCompatible; this host references both, so the publish analyses them with
    their SDKs. The GCP adapter is not marked: the Google Cloud SDK warns when trimmed (plan 09 IR-08). PublishAot is set here, not on the command line, because a global property also reaches the
    netstandard2.0 source generator (NETSDK1207).
  -->
  <PropertyGroup>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Only for the check: PublishAot restores the ILCompiler package, which ordinary builds don't need. -->
    <PublishAot Condition="'$(SourceFlowAotCheck)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Cloud\SourceFlow.Cloud.Aws\SourceFlow.Cloud.Aws.csproj" />
    <ProjectReference Include="..\..\..\src\Cloud\SourceFlow.Cloud.Azure\SourceFlow.Cloud.Azure.csproj" />
  </ItemGroup>
</Project>
