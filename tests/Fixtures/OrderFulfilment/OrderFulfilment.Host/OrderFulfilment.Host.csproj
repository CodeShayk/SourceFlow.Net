<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    OrderFulfilment sample host (WP-S.13): runs one of the four services (Service=orders|inventory|payments|shipping) on
    PostgreSQL, with the AWS, Azure or Google Cloud transport between them. Each service is deployed on its own; the
    design-time manifest export runs it with the same Service setting.
  -->
  <PropertyGroup>
    <UseSourceFlowGenerator>false</UseSourceFlowGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>sourceflow-order-fulfilment</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Hosting\SourceFlow.AspNetCore\SourceFlow.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\src\Storage\SourceFlow.Storage.PostgreSQL\SourceFlow.Storage.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\..\..\src\Cloud\SourceFlow.Cloud.Aws\SourceFlow.Cloud.Aws.csproj" />
    <ProjectReference Include="..\..\..\..\src\Cloud\SourceFlow.Cloud.Azure\SourceFlow.Cloud.Azure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Cloud\SourceFlow.Cloud.Gcp\SourceFlow.Cloud.Gcp.csproj" />
    <ProjectReference Include="..\..\..\..\src\Tooling\SourceFlow.Tool\SourceFlow.Tool.csproj" />
    <ProjectReference Include="..\Orders\Orders.csproj" />
    <ProjectReference Include="..\Inventory\Inventory.csproj" />
    <ProjectReference Include="..\Payments\Payments.csproj" />
    <ProjectReference Include="..\Shipping\Shipping.csproj" />
  </ItemGroup>
</Project>
